{
  "manifest_version": 3,
  "name": "知乎移动网页增强",
  "short_name": "知乎增强",
  "version": "1.1.0",
  "description": "补全知乎移动网页版被限制的功能：推荐流无限下滑、隐藏 App 内打开浮层等。本扩展不收集任何数据。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.zhihu.com/*"],
      "js": ["inject.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
